# --- CONFIGURACIÓN DE WALLET ---
# Clave privada de la cuenta que desplegará y ejecutará transacciones.
PRIVATE_KEY=0x...

# Clave privada del "Oráculo" que firma los fees dinámicos.
TRUSTED_SIGNER_PRIVATE_KEY=0x...

# --- CONFIGURACIÓN DEL CONTRATO ---
# Dirección del Hook ALA desplegado.
ALA_HOOK_ADDRESS=0x...

# --- SIMULACIÓN ---
# true = Usa Mock Tokens (Recomendado para test local)
# false = Usa Tokens Reales (Requiere saldo real)
SIMULATION=true

# --- RED ---
RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=